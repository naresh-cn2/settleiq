{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": "src/",
      "framework": "fastapi",
      "entrypoint": "settleiq/api/app.py"
    }
  },
  "rewrites": [
    { "source": "/health", "destination": { "service": "app" } },
    { "source": "/v1/(.*)", "destination": { "service": "app" } },
    { "source": "/(.*)", "destination": { "service": "app" } }
  ]
}
